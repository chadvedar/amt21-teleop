<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="human_arm">
    <xacro:property name="name" value="exo" />

    <link name="${name}/fix1">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>

            <origin rpy="0 1.570796 0" xyz="-0.05 0 0"/>

            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>

        </visual>
    </link>

    <link name="${name}/shoulder_z">
        <visual>
            <geometry>
                <cylinder length="0.20" radius="0.05"/>
            </geometry>

            <origin rpy="0 0 0" xyz="0 0 0.1"/>

            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>

        </visual>
    </link>

    <link name="${name}/elbow">
        <visual>
            <geometry>
                <cylinder length="0.20" radius="0.05"/>
            </geometry>

            <origin rpy="0 -1.570796 0" xyz="0.10 0 0"/>

            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>

        </visual>
    </link>

    <link name="${name}/wrist_x">
        <visual>
            <geometry>
                <cylinder length="0.07" radius="0.05"/>
            </geometry>

            <origin rpy="0 1.570796 0" xyz="0.035 0 0"/>

            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>

        </visual>
    </link>

    <link name="${name}/hand">
        <visual>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>

            <origin rpy="0 0 0" xyz="0 0 0.0"/>

            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>

        </visual>
    </link>

    <joint name="${name}/fix1_shoulder" type="fixed">
        <parent link="${name}/fix1"/>
        <child link="${name}/shoulder_z"/>
        <origin rpy="0 0 0" xyz="0 0 0.0"/>
    </joint>

    <joint name="${name}/shoulder_elbow" type="fixed">
        <parent link="${name}/shoulder_z"/>
        <child link="${name}/elbow"/>
        <origin rpy="0 0 0" xyz="0 0 0.2"/>
    </joint>

    <joint name="${name}/elbow_wrist" type="fixed">
        <parent link="${name}/elbow"/>
        <child link="${name}/wrist_x"/>
        <origin rpy="0 0 0" xyz="0 0 0.2"/>
    </joint>
    
    <joint name="${name}/wrist_hand" type="fixed">
        <parent link="${name}/wrist_x"/>
        <child link="${name}/hand"/>
        <origin rpy="0 0 0" xyz="0 0 0.07"/>
    </joint>

</robot>